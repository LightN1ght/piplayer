#!/bin/sh
# Unprivileged media worker. Upload *.part, then rename to *.ready.mp4.
set -u
data=${PLAYER_DATA:-/data}
runtime=${PLAYER_RUNTIME:-/run/player}
ffmpeg=${PLAYER_FFMPEG:-ffmpeg}
ffprobe=${PLAYER_FFPROBE:-ffprobe}
publisher=${PLAYER_PUBLISHER:-/usr/bin/player-publish}
interval=${PLAYER_INTERVAL:-2}
stall_timeout=${PLAYER_STALL_TIMEOUT:-60}
active="$data/media/current.mp4"
child=
publisher_child=
publisher_started=0
signature=
generation=
sequence=0
instance=$(cat /proc/sys/kernel/random/uuid)
state=waiting
audio=false
error=
retry_after=0
last_progress=0
playlist_signature=
mkdir -p "$data/media" "$data/incoming" "$runtime/hls"

publish() {
  printf '{"state":"%s","generation":"%s","audio":%s,"error":"%s"}\n' \
    "$state" "$generation" "$audio" "$error" > "$runtime/status.tmp"
  mv -f "$runtime/status.tmp" "$runtime/status.json"
}
stop_stream() {
  if [ -n "$child" ]; then
    kill -CONT "$child" 2>/dev/null || true
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
    child=
  fi
}
stop_publisher() {
  if [ -n "$publisher_child" ]; then
    kill -CONT "$publisher_child" 2>/dev/null || true
    kill "$publisher_child" 2>/dev/null || true
    wait "$publisher_child" 2>/dev/null || true
    publisher_child=
  fi
}
stop_all() { stop_stream; stop_publisher; }
trap 'stop_all; exit 0' INT TERM
trap 'stop_all' EXIT

ensure_publisher() {
  read -r uptime_seconds unused < /proc/uptime
  publisher_now=${uptime_seconds%%.*}
  if [ -n "$publisher_child" ]; then
    heartbeat=$publisher_started
    if [ -f "$runtime/publisher-heartbeat" ]; then
      read -r heartbeat < "$runtime/publisher-heartbeat" || heartbeat=$publisher_started
      case "$heartbeat" in ''|*[!0-9]*) heartbeat=$publisher_started ;; esac
    fi
    if ! kill -0 "$publisher_child" 2>/dev/null || [ "$((publisher_now - heartbeat))" -gt "$stall_timeout" ]; then
      stop_publisher
    fi
    publisher_logsize=$(stat -c %s "$runtime/publisher.log" 2>/dev/null || echo 0)
    if [ "$publisher_logsize" -gt 65536 ]; then stop_publisher; fi
  fi
  if [ -z "$publisher_child" ]; then
    publisher_started=$publisher_now
    printf '%s\n' "$publisher_now" > "$runtime/publisher-heartbeat"
    "$publisher" > "$runtime/publisher.log" 2>&1 &
    publisher_child=$!
  fi
}

validate() {
  candidate=$1
  validation_error=unsupported_media
  # Count packets to scan the whole container, not just trust its extension.
  probe=$("$ffprobe" -v error -select_streams v:0 -count_packets \
    -show_entries stream=index,codec_name,pix_fmt,nb_read_packets,width,height \
    -of default=noprint_wrappers=1 "$candidate" 2>/dev/null) || return 1
  printf '%s\n' "$probe" | grep -qx 'codec_name=h264' || return 1
  printf '%s\n' "$probe" | grep -qx 'pix_fmt=yuv420p' || return 1
  packets=$(printf '%s\n' "$probe" | sed -n 's/^nb_read_packets=//p')
  case "$packets" in ''|*[!0-9]*) return 1 ;; esac
  [ "$packets" -gt 0 ] || return 1
  video_index=$(printf '%s\n' "$probe" | sed -n 's/^index=//p')
  audio_probe=$("$ffprobe" -v error -select_streams a:0 -show_entries stream=index,codec_name \
    -of default=noprint_wrappers=1 "$candidate" 2>/dev/null) || return 1
  codec=$(printf '%s\n' "$audio_probe" | sed -n 's/^codec_name=//p')
  audio_index=$(printf '%s\n' "$audio_probe" | sed -n 's/^index=//p')
  [ -n "$audio_index" ] || audio_index=-1
  case "$codec" in aac) validated_audio=true ;; '') validated_audio=false ;; *) return 1 ;; esac
  # A fixed live HLS target needs bounded keyframe gaps. Scan packets only;
  # transcoding stays on the user's computer, not on the Pi.
  if ! "$ffprobe" -v error -show_packets \
      -show_entries packet=stream_index,pts_time,dts_time,duration_time,size,flags -of compact=p=0 "$candidate" 2>/dev/null |
      awk -F '|' -v video="$video_index" -v audio="$audio_index" '
        {
          pts=""; dts=""; flags=""; sid=""; size=""; duration=0
          for (i=1; i<=NF; i++) {
            if ($i ~ /^pts_time=/) { pts=$i; sub(/^pts_time=/,"",pts) }
            if ($i ~ /^dts_time=/) { dts=$i; sub(/^dts_time=/,"",dts) }
            if ($i ~ /^flags=/) { flags=$i; sub(/^flags=/,"",flags) }
            if ($i ~ /^stream_index=/) { sid=$i; sub(/^stream_index=/,"",sid) }
            if ($i ~ /^size=/) { size=$i; sub(/^size=/,"",size) }
            if ($i ~ /^duration_time=/) { duration=$i; sub(/^duration_time=/,"",duration) }
          }
          if (sid=="" || (sid!=video && sid!=audio)) next
          clock=dts
          if (clock !~ /^-?[0-9]+([.][0-9]+)?$/) clock=pts
          if (clock !~ /^-?[0-9]+([.][0-9]+)?$/ || size !~ /^[0-9]+$/) { bad=1; next }
          clock+=0; size+=0
          if (duration !~ /^[0-9]+([.][0-9]+)?$/) duration=0
          if (!allpackets || clock<start) start=clock
          if (!allpackets || clock+duration>end) end=clock+duration
          allpackets++; bytes+=size
          bucket=int(clock); if (clock<bucket) bucket--
          buckets[bucket]+=size
          # 6 Mbit/s in every one-second timestamp bucket, not merely a
          # container bitrate hint. Leave room for TS overhead and retention.
          if (buckets[bucket]>750000) bad=1
          if (sid!=video) next
          if (pts !~ /^-?[0-9]+([.][0-9]+)?$/) { bad=1; next }
          pts+=0
          if (!packets || pts<first) first=pts
          if (!packets || pts>last) last=pts
          packets++
          if (flags ~ /K/) {
            if (keys && (pts<keytime || pts-keytime>4.0001)) bad=1
            if (!keys) firstkey=pts
            keytime=pts; keys++
          }
        }
        END {
          if (!packets || !keys || bad || last-keytime+firstkey-first>4.0001 ||
              end<=start || bytes/(end-start)>750000) exit 1
        }'; then
    validation_error=needs_preparation
    return 1
  fi
}

for dependency in "$ffmpeg" "$ffprobe" "$publisher" stat; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    state=error
    error=missing_dependency
    publish
    printf 'PiPlayer: missing required command: %s\n' "$dependency" >&2
    sleep 30
    exit 1
  fi
done
publish
while :; do
  ensure_publisher
  if [ "$error" = buffer_busy ]; then error=; fi
  for candidate in "$data/incoming/"*.ready.mp4; do
    [ -f "$candidate" ] || continue
    # Rapid replacements may leave legitimate retired segments in RAM. Keep
    # the current stream and defer ready files until retention frees headroom.
    available=$(df -Pk "$runtime" 2>/dev/null | awk 'NR==2 {print $4}')
    case "$available" in ''|*[!0-9]*) available=0 ;; esac
    if [ "$available" -lt 40960 ]; then
      error=buffer_busy
      publish
      continue
    fi
    if validate "$candidate"; then
      if mv -f "$candidate" "$active"; then
        sync
        error=
        signature=
        retry_after=0
      else
        error=upload_failed
      fi
    else
      mv -f "$candidate" "$candidate.rejected" 2>/dev/null || true
      error=$validation_error
    fi
    publish
  done

  if [ ! -f "$active" ]; then
    stop_stream
    state=waiting
    generation=
    signature=
    publish
    sleep "$interval"
    continue
  fi
  current=$(stat -c '%i:%s:%Y' "$active" 2>/dev/null) || { sleep "$interval"; continue; }
  read -r uptime_seconds unused < /proc/uptime
  now=${uptime_seconds%%.*}
  if [ "$signature" != "$current" ] && [ "$now" -ge "$retry_after" ]; then
    if ! validate "$active"; then
      state=error
      error=$validation_error
      retry_after=$((now + 10))
      publish
      sleep "$interval"
      continue
    fi
    stop_stream
    # Segment paths change on restart, avoiding browser cache collisions.
    # The public playlist may still refer to old segments. Its publisher owns
    # their bounded retention and cleanup after clients have had time to fetch.
    sequence=$((sequence + 1))
    generation="$instance-$$-$sequence"
    mkdir -p "$runtime/hls/$generation"
    state=buffering
    audio=$validated_audio
    error=
    publish
    "$ffmpeg" -nostdin -hide_banner -loglevel error -nostats \
      -re -stream_loop -1 -i "$active" -map 0:v:0 -map '0:a:0?' -sn -dn \
      -c copy -f hls -hls_time 2 -hls_list_size 5 \
      -hls_flags omit_endlist+temp_file \
      -hls_segment_filename "$runtime/hls/$generation/segment-%09d.ts" \
      "$runtime/hls/$generation/index.m3u8" 2> "$runtime/ffmpeg.log" &
    child=$!
    signature=$current
    playlist_signature=
    last_progress=$now
  fi
  if [ -n "$child" ]; then
    if ! kill -0 "$child" 2>/dev/null; then
      wait "$child" 2>/dev/null || true
      child=
      signature=
      state=error
      error=stream_failed
      retry_after=$((now + 5))
    elif [ -f "$runtime/hls/$generation/index.m3u8" ]; then
      state=playing
      progress=$(stat -c '%i:%s:%Y' "$runtime/hls/$generation/index.m3u8" 2>/dev/null || echo '')
      if [ "$progress" != "$playlist_signature" ]; then
        playlist_signature=$progress
        last_progress=$now
      fi
    fi
    if [ -n "$child" ] && [ "$((now - last_progress))" -ge "$stall_timeout" ]; then
      stop_stream
      signature=
      state=error
      error=stream_stalled
      retry_after=$((now + 5))
    fi
    # A broken input cannot grow a log without bounds on the RAM filesystem.
    logsize=$(stat -c %s "$runtime/ffmpeg.log" 2>/dev/null || echo 0)
    if [ "$logsize" -gt 65536 ]; then
      stop_stream
      signature=
      state=error
      error=stream_failed
      retry_after=$((now + 10))
    fi
  fi
  publish
  sleep "$interval"
done

